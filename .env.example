# Copy to .env and fill in. Never commit .env (it is gitignored); keep real keys out of this file.

# LLM providers (at least one is needed for live runs; tests use a fake client)
GOOGLE_API_KEY=
GROQ_API_KEY=
# Which model each agent uses, output caps and budget shares: config/llm.yaml
# KAI_LLM_CONFIG_PATH=config/llm.yaml

# Gateway: a single-user LOCAL app with no authentication.
# It listens on localhost only and accepts browser requests only from the Vite dev server.
# Add authentication before changing GATEWAY_HOST or CORS to expose it on any network.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Comma-separated browser origins allowed to call the API
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite file for sessions, history and chat
KAI_DB_URL=sqlite:///./kai.db
# How many debates may run at the same time
KAI_MAX_CONCURRENT_DEBATES=2

# AP2 signing key (Ed25519). If the file does not exist it is generated on first run.
# Keep it out of git (*.pem is gitignored).
AP2_PRIVATE_KEY_PATH=ap2_private_key.pem
# Optional; derived from the private path if unset
# AP2_PUBLIC_KEY_PATH=ap2_public_key.pem
